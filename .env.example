# Copie para .env e preencha. Valores abaixo são apenas ilustrativos.
# Deixe SUPABASE_URL ou SUPABASE_KEY vazios para usar o MODO DEMONSTRAÇÃO LOCAL.
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_KEY=sua-chave-anon-aqui
SUPABASE_TABLE=animal_reports

# Armazenamento local (caminhos relativos à raiz do projeto)
IMAGES_DIR=data/images
DEMO_DB_PATH=data/demo_db.json

# Modelo CLIP pré-treinado (Hugging Face)
CLIP_MODEL_NAME=openai/clip-vit-base-patch32
MAX_UPLOAD_MB=5
